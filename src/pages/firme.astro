---
import { Picture } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { noWidow } from '../utils/noWidow';

import stirling from '../assets/work/stirling-education/media-23.png';
import longClose from '../assets/work/long-close-school/media-6.png';
import bcLaw from '../assets/work/bc-law-ltd/media-9.png';
import redshift from '../assets/work/redshift-education/media-13.png';

const WHATSAPP_NUMBER = '38763031859';
const PHONE_NUMBER = '+38763031859';
const EMAIL = 'adnan.kevric@settagency.com';
const WA_TEXT = 'Zdravo, zanima me besplatna analiza sajta. Naš sajt je: ';
const waHref = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(WA_TEXT)}`;
const mailHref = `mailto:${EMAIL}?subject=${encodeURIComponent('Besplatna analiza sajta')}`;

const sizes = '(max-width: 768px) 100vw, 640px';

const projects = [
  { img: stirling, name: 'Stirling Education', where: 'Međunarodna mreža', text: 'Jedan sajt za cijelu mrežu škola i univerziteta u više država.', alt: 'Početna stranica Stirling Education' },
  { img: bcLaw, name: 'BC Law', where: 'London', text: 'Advokatska kancelarija koja izgleda pouzdano, bez klišeja.', alt: 'Sajt advokatske kancelarije BC Law' },
  { img: longClose, name: 'Long Close School', where: 'Velika Britanija', text: 'Škola od 1941. sa sajtom koji konačno prati njenu reputaciju.', alt: 'Početna stranica Long Close School' },
  { img: redshift, name: 'Redshift Education', where: 'Velika Britanija', text: 'Sajt za grupu škola koja raste.', alt: 'Sajt Redshift Education na monitoru' },
];
---

<Layout
  title="Vaš sajt, bez brige | Sett"
  description="Sajt za Vašu firmu, od teksta do održavanja. Besplatna analiza postojećeg sajta ili besplatan plan ako ga nemate."
  lang="bs"
  noindex
  ogImage="/web/showreel-poster.jpg"
>

  <!-- 1. Showreel -->
  <div class="f-reel">
    <div class="f-reel-frame">
      <video id="reel" class="f-reel-video" autoplay muted loop playsinline preload="metadata" poster="/web/showreel-poster.jpg">
        <source src="/web/showreel.mp4" type="video/mp4" />
      </video>
      <button id="reelSound" class="f-sound" type="button" aria-pressed="false" data-umami-event="firme-showreel-zvuk">Uključi zvuk</button>
    </div>
  </div>

  <!-- 2. Hero -->
  <section class="f-hero">
    <p class="f-prepared" id="preparedFor" hidden>Pripremljeno za <span id="preparedName"></span></p>
    <h1 class="f-title">{noWidow('Vaš sajt, bez da se Vi bavite njime.')}</h1>
    <div class="f-intro">
      <p>{noWidow('Za firme koje rade ozbiljne projekte i nemaju vremena za sajt. Mi preuzimamo sve, od teksta do održavanja. Za početak besplatno pregledamo Vaš sajt, a ako ga nemate, napravimo Vam besplatan plan.')}</p>
      <div class="f-hero-buttons">
        <a class="f-btn f-btn--dark" href="#kontakt" data-scroll>Zatražite besplatnu analizu</a>
        <a class="f-btn f-btn--line" href="#radovi" data-scroll>Pogledajte primjere</a>
      </div>
    </div>
  </section>

  <!-- 3. Kako radimo -->
  <section class="f-section f-dark">
    <p class="f-eyebrow">Kako radimo</p>
    <h2 class="f-h2 f-h2--gap">{noWidow('Vi radite svoj posao. Sajt je naša briga.')}</h2>
    <div class="f-points">
      <div class="f-point">
        <h3>Sve radimo mi</h3>
        <p>{noWidow('Tekstovi, fotografije, dizajn i izrada. Od Vas trebamo jedan razgovor i podatke o firmi, ostalo je na nama.')}</p>
      </div>
      <div class="f-point">
        <h3>Završeno znači završeno</h3>
        <p>{noWidow('Rok i cijenu dogovorimo unaprijed. Kad je posao plaćen, sajt je gotov, radi na mobitelu i računaru, i ne morate nikoga juriti.')}</p>
      </div>
      <div class="f-point">
        <h3>Održavanje po želji</h3>
        <p>{noWidow('Mjesečno objavljujemo Vaše nove projekte i novosti, pazimo na sigurnost i radimo izmjene. Sajt nikad više ne zastari.')}</p>
      </div>
    </div>
  </section>

  <!-- 4. Primjeri -->
  <section class="f-section" id="radovi">
    <p class="f-eyebrow">Primjeri</p>
    <h2 class="f-h2 f-h2--gap">{noWidow('Sajtovi koje smo radili')}</h2>
    <div class="f-grid">
      {projects.map((p) => (
        <figure>
          <div class="f-img">
            <Picture src={p.img} formats={['webp']} fallbackFormat="jpg" widths={[640, 1280]} sizes={sizes} alt={p.alt} loading="lazy" />
          </div>
          <figcaption><strong>{p.name}</strong> <span class="f-where">{p.where}</span><br />{noWidow(p.text)}</figcaption>
        </figure>
      ))}
    </div>
    <a class="f-link" href="/work">Svi projekti →</a>
  </section>

  <!-- 5. Kontakt -->
  <section class="f-section f-dark" id="kontakt">
    <p class="f-eyebrow">Kontakt</p>
    <h2 class="f-h2">{noWidow('Pošaljite nam link ili nas nazovite.')}</h2>
    <p class="f-body">{noWidow('Javite se na WhatsApp, mail ili telefon. Ako nemate sajt, napišite nam samo čime se firma bavi.')}</p>
    <div class="f-buttons">
      <a class="f-btn f-btn--solid" href={waHref} data-wa data-umami-event="firme-whatsapp" target="_blank" rel="noopener noreferrer">WhatsApp</a>
      <a class="f-btn f-btn--outline" id="mailBtn" href={mailHref} data-umami-event="firme-email">Pošaljite mail</a>
      <a class="f-btn f-btn--outline" href={`tel:${PHONE_NUMBER}`} data-umami-event="firme-telefon">Pozovite nas</a>
      <a class="f-phone" href={`tel:${PHONE_NUMBER}`} data-umami-event="firme-telefon">+387 63 031 859</a>
    </div>
  </section>

</Layout>

<style>
  .f-reel, .f-hero, .f-section {
    --px: clamp(16px, 6vw, 80px);
    --py: clamp(64px, 9vw, 120px);
  }

  .f-reel { padding: calc(24px + 18px + 56px) var(--px) 0; }
  .f-reel-frame { position: relative; max-width: 1600px; margin: 0 auto; aspect-ratio: 16 / 9; border-radius: 20px; overflow: hidden; background: #E5E4E0; }
  .f-reel-video { width: 100%; height: 100%; object-fit: contain; display: block; }
  .f-sound { position: absolute; right: 16px; bottom: 16px; padding: 10px 18px; border-radius: 999px; border: none; background: rgba(17,17,17,0.72); color: #F7F6F2; font-family: inherit; font-size: 14px; font-weight: 500; cursor: pointer; backdrop-filter: blur(6px); }
  .f-sound:hover { background: #111111; }
  .f-sound:focus-visible { outline: 2px solid #F7F6F2; outline-offset: 2px; }

  .f-hero { padding: clamp(48px, 6vw, 88px) var(--px) var(--py); max-width: 1600px; margin: 0 auto; }
  .f-prepared { margin-bottom: 20px; font-size: 15px; color: #555555; }
  .f-prepared span { color: #111111; font-weight: 600; }
  .f-title { font-size: clamp(2.5rem, 6vw, 6.5rem); font-weight: 400; line-height: 1.05; letter-spacing: -0.02em; color: #111111; max-width: 15ch; }
  .f-intro { display: grid; grid-template-columns: 1fr auto; gap: 48px; align-items: end; margin-top: clamp(32px, 4vw, 56px); padding-top: clamp(24px, 3vw, 40px); border-top: 0.5px solid #BBBBBB; }
  .f-intro p { font-size: 20px; font-weight: 300; line-height: 1.6; color: #333333; max-width: 60ch; }
  .f-hero-buttons { display: flex; gap: 12px; flex-wrap: wrap; }

  .f-section { padding: var(--py) var(--px); }
  .f-dark { background: #111111; color: #F7F6F2; }
  .f-dark :is(h2, h3, p) { color: inherit; }
  .f-eyebrow { font-size: 12px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.12em; color: #888888; margin-bottom: 20px; }
  .f-h2 { font-size: clamp(2rem, 4vw, 3.25rem); font-weight: 400; line-height: 1.12; letter-spacing: -0.015em; max-width: 22ch; }
  .f-h2--gap { margin-bottom: clamp(32px, 4vw, 56px); }

  .f-points { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(24px, 3vw, 48px); }
  .f-point { border-top: 1px solid rgba(247,246,242,0.4); padding-top: 20px; }
  .f-point h3 { font-size: 22px; font-weight: 400; margin-bottom: 12px; }
  .f-point p { font-size: 17px; font-weight: 300; line-height: 1.65; color: rgba(247,246,242,0.8) !important; }

  .f-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px 24px; }
  .f-img { aspect-ratio: 16 / 9; overflow: hidden; border-radius: 20px; background: #E5E4E0; }
  .f-img :global(picture), .f-img :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  figure { margin: 0; }
  figcaption { margin-top: 12px; font-size: 15px; font-weight: 300; line-height: 1.6; color: #555555; }
  figcaption strong { font-weight: 600; color: #111111; margin-right: 6px; }
  .f-where { font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; color: #888888; }
  .f-link { display: inline-block; margin-top: 32px; color: #111111; font-size: 15px; font-weight: 500; text-underline-offset: 4px; }

  .f-body { font-size: 18px; font-weight: 300; line-height: 1.7; margin-top: 20px; max-width: 56ch; color: rgba(247,246,242,0.8) !important; }
  .f-buttons { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 40px; align-items: center; }
  .f-btn { display: inline-flex; align-items: center; justify-content: center; padding: 14px 26px; border-radius: 999px; text-decoration: none; font-size: 15px; font-weight: 500; border: 1px solid transparent; }
  .f-btn--dark { background: #111111; color: #F7F6F2; }
  .f-btn--line { border-color: #111111; color: #111111; }
  .f-btn--solid { background: #F7F6F2; color: #111111; }
  .f-btn--outline { border-color: rgba(247,246,242,0.5); color: #F7F6F2; }
  .f-btn--outline:hover { border-color: #F7F6F2; }
  .f-phone { margin-left: 12px; color: #F7F6F2; font-size: 18px; font-weight: 500; text-decoration: none; }
  .f-phone:hover { text-decoration: underline; text-underline-offset: 4px; }

  @media (max-width: 768px) {
    .f-reel-frame { border-radius: 12px; }
    .f-sound { right: 10px; bottom: 10px; padding: 8px 14px; font-size: 13px; }
    .f-intro, .f-points, .f-grid { grid-template-columns: 1fr; }
    .f-title { font-size: 40px; }
    .f-h2 { font-size: 32px; }
    .f-buttons, .f-hero-buttons { flex-direction: column; align-items: stretch; }
    .f-btn { width: 100%; }
    .f-phone { margin: 8px 0 0; }
  }
</style>

<script>
  const params = new URLSearchParams(window.location.search);
  const rawName = (params.get('r') ?? '').trim().slice(0, 60);
  if (rawName) {
    const line = document.getElementById('preparedFor');
    const nameEl = document.getElementById('preparedName');
    if (line && nameEl) { nameEl.textContent = rawName; line.hidden = false; }
    document.querySelectorAll<HTMLAnchorElement>('a[data-wa]').forEach((a) => {
      const text = `Zdravo, zanima me besplatna analiza sajta. Firma: ${rawName}. Naš sajt je: `;
      a.href = `https://wa.me/38763031859?text=${encodeURIComponent(text)}`;
      a.setAttribute('data-umami-event-firma', rawName);
    });
    const mail = document.getElementById('mailBtn') as HTMLAnchorElement | null;
    if (mail) {
      mail.href = `mailto:adnan.kevric@settagency.com?subject=${encodeURIComponent('Besplatna analiza sajta: ' + rawName)}`;
      mail.setAttribute('data-umami-event-firma', rawName);
    }
    // Umami: zabilježi otvaranje personalizovanog linka
    let tries = 0;
    const track = () => {
      const umami = (window as any).umami;
      if (umami && typeof umami.track === 'function') { umami.track('firme-otvoren', { firma: rawName }); return; }
      if (++tries < 10) setTimeout(track, 300);
    };
    if (document.readyState === 'complete') track(); else window.addEventListener('load', track);
  }

  const scrollTo = (id: string) => {
    const target = document.getElementById(id);
    if (!target) return;
    const lenis = (window as any).__lenis;
    if (lenis) lenis.scrollTo(target); else target.scrollIntoView({ behavior: 'smooth' });
  };
  document.querySelectorAll<HTMLAnchorElement>('a[data-scroll]').forEach((a) => {
    a.addEventListener('click', (e) => {
      const id = a.getAttribute('href')?.replace('#', '');
      if (!id) return;
      e.preventDefault();
      scrollTo(id);
    });
  });

  // Header: Contact skrola na kontakt
  document.querySelectorAll<HTMLAnchorElement>('.nav-link[href="/contact"]').forEach((link) => {
    link.href = '#kontakt';
    const label = link.querySelector('.link-text');
    if (label) label.textContent = 'Kontakt';
    link.addEventListener('click', (e) => {
      if (!document.getElementById('kontakt')) return;
      e.preventDefault();
      setTimeout(() => scrollTo('kontakt'), 350);
    });
  });

  // Showreel: zvuk
  const reel = document.getElementById('reel') as HTMLVideoElement | null;
  const soundBtn = document.getElementById('reelSound') as HTMLButtonElement | null;
  if (reel && soundBtn) {
    soundBtn.addEventListener('click', () => {
      const on = reel.muted;
      reel.muted = !on;
      if (on) { reel.currentTime = 0; reel.play().catch(() => {}); }
      soundBtn.textContent = on ? 'Isključi zvuk' : 'Uključi zvuk';
      soundBtn.setAttribute('aria-pressed', String(on));
    });
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) reel.pause();
  }
</script>

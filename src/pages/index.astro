---
import Layout from '../layouts/Layout.astro';
import { noWidow } from '../utils/noWidow';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import foundersImg from '../assets/brand/Team/varvara-adnan-founders.jpg';

const allImages = import.meta.glob<{ default: ImageMetadata }>('../assets/work/**/*.png');
const workEntries = await getCollection('work');
const svcSlugs = ['stirling-education', 'laleon-exclusive', 'dope-jewelry-launch-campaign', 'dope-jewelry-bean-up'];
const svcCover: Record<string, ImageMetadata | undefined> = {};
const svcVideo: Record<string, string> = {};
for (const entry of workEntries) {
  const slug = entry.id.replace(/\.md$/, '');
  if (!svcSlugs.includes(slug)) continue;
  const f = entry.data.cover;
  if (!f) continue;
  if (f.endsWith('.mp4')) { svcVideo[slug] = f; }
  else { const mod = await allImages[`../assets/work/${slug}/${f}`]?.(); svcCover[slug] = mod?.default; }
}

const quoteText = "We're driven by the desire to make things that last. Not just visually, but strategically. Work that holds up over time, that grows with the client, that means something beyond the brief.";
const quoteWords = quoteText.split(' ');

const clients = [
  'Stirling Education',
  'Redshift',
  'Long Close',
  'Polam',
  'Castle College',
  'Dope Jewelry',
  'BC Law',
  'Advelop',
  'Agdal Nuhanović',
];

const logoModules = import.meta.glob<string>('../assets/brand/client-logos/*.svg', { query: '?raw', import: 'default', eager: true });
const clientLogos = Object.values(logoModules);
---

<Layout
  title="Sett Agency"
  description="Sett builds brands and websites as complete systems. Branding, web, content and digital marketing."
>
  <main class="hp-main">

    <!-- 1. Hero: full-height, title + body anchored bottom-left -->
    <section class="hp-hero">
      <h1 class="hp-heading">
        <span class="hp-line"><span class="hp-line-inner">{noWidow("Setting up brands that")}</span></span>
        <span class="hp-line"><span class="hp-line-inner">{noWidow("value their business.")}</span></span>
      </h1>
      <p class="hp-sub">{noWidow("Sett is a creative agency built on a simple belief: that the best work comes from people who refuse to settle for average.")}</p>
    </section>

    <!-- 2. Founders quote -->
    <section class="hp-quote">
      <span class="quote-mark" aria-hidden="true">&ldquo;</span>
      <div class="quote-column">
        <p class="quote-text">
          {quoteWords.map((word, i) => (
            <span class="quote-word">{word}{i < quoteWords.length - 1 ? ' ' : ''}</span>
          ))}
        </p>
      </div>
      <div class="quote-attribution">
        <div class="founders-photo">
          <Image src={foundersImg} alt="Adnan Kevrić and Varvara Šešlija, founders of Sett" style="width:100%;height:100%;object-fit:cover;display:block;" />
        </div>
        <div class="attr-text">
          <p class="attr-name">Adnan &amp; Varvara</p>
          <p class="attr-role">Founders, Sett</p>
        </div>
      </div>
    </section>

    <!-- 3. Services -->
    <section class="hp-services">

      <aside class="services-sidebar">
        <p class="services-eyebrow">Services</p>
        <nav class="services-nav" aria-label="Service sections">
          <a href="/services#brand-identity" class="services-link is-active" data-target="hp-brand-identity">Brand Identity</a>
          <a href="/services#web" class="services-link" data-target="hp-web">Web</a>
          <a href="/services#content" class="services-link" data-target="hp-content">Content</a>
          <a href="/services#digital-marketing" class="services-link" data-target="hp-digital-marketing">Digital Marketing</a>
        </nav>
      </aside>

      <div class="services-content">

        <div class="service-panel" id="hp-brand-identity">
          <h2 class="sv-heading">{noWidow("Brand Identity")}</h2>
          <p class="sv-lead">{noWidow("Your brand is how people decide whether to trust you before they speak to you.")}</p>
          <div class="sv-project">
            <div class="sv-proj-img">
              {svcCover['stirling-education'] ? (
                <Image src={svcCover['stirling-education']!} alt="" style="width:100%;height:100%;object-fit:cover;display:block;" />
              ) : (
                <span class="sv-proj-img-label">Project image</span>
              )}
            </div>
            <div class="sv-proj-info">
              <h3 class="sv-proj-name">{noWidow("Stirling Education")}</h3>
              <p class="sv-proj-desc">{noWidow("A complete brand system built from a single visual source.")}</p>
              <span class="sv-proj-tag">Brand + Web + Social</span>
              <a href="/work/stirling-education" class="sv-cs-link">
                <span class="sv-cs-text">View case study</span>
                <span class="sv-cs-arrow">→</span>
              </a>
            </div>
          </div>
        </div>

        <div class="service-panel" id="hp-web">
          <h2 class="sv-heading">{noWidow("Web")}</h2>
          <p class="sv-lead">{noWidow("A website that performs is designed around what your audience needs to do.")}</p>
          <div class="sv-project">
            <div class="sv-proj-img">
              {svcCover['laleon-exclusive'] ? (
                <Image src={svcCover['laleon-exclusive']!} alt="" style="width:100%;height:100%;object-fit:cover;display:block;" />
              ) : (
                <span class="sv-proj-img-label">Project image</span>
              )}
            </div>
            <div class="sv-proj-info">
              <h3 class="sv-proj-name">{noWidow("Laleon Exclusive")}</h3>
              <p class="sv-proj-desc">{noWidow("A fine jewelry e-commerce store built for launch.")}</p>
              <span class="sv-proj-tag">WooCommerce + E-commerce</span>
              <a href="/work/laleon-exclusive" class="sv-cs-link">
                <span class="sv-cs-text">View case study</span>
                <span class="sv-cs-arrow">→</span>
              </a>
            </div>
          </div>
        </div>

        <div class="service-panel" id="hp-content">
          <h2 class="sv-heading">{noWidow("Content")}</h2>
          <p class="sv-lead">{noWidow("Good content gives people a reason to come back.")}</p>
          <div class="sv-project">
            <div class="sv-proj-img">
              {svcVideo['dope-jewelry-launch-campaign'] ? (
                <video autoplay muted loop playsinline style="width:100%;height:100%;object-fit:cover;display:block;">
                  <source src={`/work/dope-jewelry-launch-campaign/${svcVideo['dope-jewelry-launch-campaign']}`} type="video/mp4" />
                </video>
              ) : svcCover['dope-jewelry-launch-campaign'] ? (
                <Image src={svcCover['dope-jewelry-launch-campaign']!} alt="" style="width:100%;height:100%;object-fit:cover;display:block;" />
              ) : (
                <span class="sv-proj-img-label">Project image</span>
              )}
            </div>
            <div class="sv-proj-info">
              <h3 class="sv-proj-name">{noWidow("Dope Jewelry: Launch Campaign")}</h3>
              <p class="sv-proj-desc">{noWidow("A launch campaign built from concept to final asset.")}</p>
              <span class="sv-proj-tag">Campaign + Production</span>
              <a href="/work/dope-jewelry-launch-campaign" class="sv-cs-link">
                <span class="sv-cs-text">View case study</span>
                <span class="sv-cs-arrow">→</span>
              </a>
            </div>
          </div>
        </div>

        <div class="service-panel" id="hp-digital-marketing">
          <h2 class="sv-heading">{noWidow("Digital Marketing")}</h2>
          <p class="sv-lead">{noWidow("Presence without consistency is noise.")}</p>
          <div class="sv-project">
            <div class="sv-proj-img">
              {svcVideo['dope-jewelry-bean-up'] ? (
                <video autoplay muted loop playsinline style="width:100%;height:100%;object-fit:cover;display:block;">
                  <source src={`/work/dope-jewelry-bean-up/${svcVideo['dope-jewelry-bean-up']}`} type="video/mp4" />
                </video>
              ) : svcCover['dope-jewelry-bean-up'] ? (
                <Image src={svcCover['dope-jewelry-bean-up']!} alt="" style="width:100%;height:100%;object-fit:cover;display:block;" />
              ) : (
                <span class="sv-proj-img-label">Project image</span>
              )}
            </div>
            <div class="sv-proj-info">
              <h3 class="sv-proj-name">{noWidow("Dope Jewelry: Bean Up Campaign")}</h3>
              <p class="sv-proj-desc">{noWidow("3D ads built for paid social. A bean-shaped collection launched at scale.")}</p>
              <span class="sv-proj-tag">3D + Paid Ads</span>
              <a href="/work/dope-jewelry-bean-up" class="sv-cs-link">
                <span class="sv-cs-text">View case study</span>
                <span class="sv-cs-arrow">→</span>
              </a>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- 4. Who we work with -->
    <section class="hp-clients">
      <div class="clients-copy">
        <p class="clients-label">{noWidow("Who we work with")}</p>
        <p class="clients-body">{noWidow("There is no typical Sett client. We have worked with organisations across Europe, different sectors, different sizes, different markets. What they share is a seriousness about how they show up and a willingness to do the work properly. If you value your business, we'll help you set it apart.")}</p>
      </div>
      <div class="marquee" aria-hidden="true">
        <div class="marquee-track">
          {clientLogos.map(svg => <span class="marquee-logo" set:html={svg} />)}
          {clientLogos.map(svg => <span class="marquee-logo" set:html={svg} />)}
        </div>
      </div>
      <ul class="sr-only">
        {clients.map(c => <li>{c}</li>)}
      </ul>
    </section>

  </main>
</Layout>

<style>
  :root {
    --px: clamp(24px, 6vw, 80px);
    --py: clamp(60px, 8vw, 96px);
    --nav-h: 64px;
  }

  /* ── Hero ────────────────────────────────────────────────────── */
  .hp-hero {
    height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 0 var(--px) clamp(48px, 6vw, 80px);
    border-bottom: 0.5px solid #E5E4E0;
  }

  .hp-heading {
    font-size: clamp(4.41rem, 7.056vw, 7.35rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: #111111;
    max-width: 28ch;
    word-wrap: break-word;
    overflow-wrap: break-word;
  }

  /* Line reveal wrappers — layout-neutral, only exist for the animation */
  .hp-line {
    display: block;
    overflow: hidden;
    margin-bottom: -0.2em; /* cancels the padding-bottom below so line spacing is unchanged */
  }

  .hp-line-inner {
    display: block;
    padding-bottom: 0.2em; /* extends the border-box below the baseline so descenders clear both clip boundaries */
  }

  @media (max-width: 768px) {
    .hp-hero {
      justify-content: flex-end;
      padding-top: 0;
      padding-bottom: clamp(140px, 22vh, 180px);
    }
    .hp-heading {
      font-size: clamp(2.4rem, 11vw, 3.75rem);
      line-height: 1.1;
    }
  }

  .hp-sub {
    margin-top: clamp(20px, 2.5vh, 32px);
    font-size: clamp(20px, 1.6vw, 22px);
    font-weight: 400;
    line-height: 1.65;
    color: #111111;
    max-width: 60ch;
  }

  /* ── Founders quote ──────────────────────────────────────────── */
  .hp-quote {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(48px, 6vw, 80px) var(--px);
    position: relative;
    border-bottom: 0.5px solid #E5E4E0;
    overflow: hidden;
  }

  .quote-mark {
    font-size: clamp(6rem, 12vw, 14rem);
    font-weight: 700;
    line-height: 0.75;
    color: #BBBBBB;
    align-self: flex-start;
    user-select: none;
  }

  .quote-column {
    width: 100%;
    max-width: 900px;
    align-self: center;
    flex: 1;
    display: flex;
    align-items: center;
  }

  .quote-text {
    font-size: clamp(1.8rem, 3.2vw, 4rem);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: #BBBBBB;
  }

  .quote-word {
    color: #BBBBBB;
    display: inline;
  }

  .quote-attribution {
    display: flex;
    align-items: center;
    gap: 16px;
    align-self: flex-start;
  }

  .founders-photo {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    overflow: hidden;
  }

  .attr-name {
    font-size: 15px;
    font-weight: 700;
    line-height: 1.3;
    color: #111111;
  }

  .attr-role {
    font-size: 13px;
    font-weight: 300;
    line-height: 1.4;
    letter-spacing: 0.04em;
    color: #888888;
  }

  @media (prefers-reduced-motion: reduce) {
    .quote-word { color: #111111; }
  }

  @media (max-width: 768px) {
    .quote-column { max-width: none; }
  }

  /* ── Services ────────────────────────────────────────────────── */
  .hp-services {
    display: grid;
    grid-template-columns: 280px 1fr;
    align-items: start;
    border-bottom: 0.5px solid #E5E4E0;
  }

  .services-sidebar {
    position: sticky;
    top: 64px;
    align-self: start;
    padding: clamp(36px, 5vw, 56px) 40px clamp(36px, 5vw, 56px) var(--px);
    border-right: 0.5px solid #E5E4E0;
    min-height: calc(100vh - 64px);
  }

  .services-eyebrow {
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #888888;
    margin-bottom: 28px;
  }

  .services-nav {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .services-link {
    font-size: 17px;
    font-weight: 400;
    color: #555555;
    padding: 6px 0;
    transition: color 0.2s ease;
    text-decoration: none;
    line-height: 1.4;
  }

  .services-link:hover { color: #333333; }
  .services-link.is-active { font-weight: 600; color: #111111; }

  .service-panel {
    padding: clamp(48px, 6vw, 80px) clamp(40px, 5vw, 72px);
    border-bottom: 0.5px solid #E5E4E0;
  }

  .service-panel:last-child { border-bottom: none; }

  .sv-heading {
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: #111111;
    margin-bottom: 24px;
  }

  .sv-lead {
    font-size: 22px;
    font-weight: 300;
    line-height: 1.6;
    color: #111111;
  }

  /* Project card within each panel */
  .sv-project {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(24px, 3vw, 40px);
    margin-top: clamp(32px, 4vw, 48px);
    padding-top: clamp(32px, 4vw, 48px);
    border-top: 0.5px solid #E5E4E0;
    align-items: stretch;
  }

  .sv-proj-img {
    background: #F0EFEB;
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    align-self: start;
  }

  .sv-proj-info {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .sv-proj-img-label {
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #888888;
  }

  .sv-proj-name {
    font-size: clamp(20px, 2.2vw, 28px);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: #111111;
    margin-bottom: 8px;
  }

  .sv-proj-desc {
    font-size: 17px;
    font-weight: 300;
    line-height: 1.5;
    color: #555555;
    margin-bottom: 16px;
  }

  .sv-proj-tag {
    display: inline-block;
    align-self: flex-start;
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #888888;
    background: #F0EFEB;
    padding: 6px 10px;
  }

  .sv-cs-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 20px;
    font-size: 14px;
    font-weight: 300;
    color: #111111;
    text-decoration: none;
  }

  .sv-cs-text {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 0.5px;
    text-underline-offset: 3px;
    transition: text-decoration-color 0.2s ease;
  }

  .sv-cs-link:hover .sv-cs-text {
    text-decoration-color: #111111;
  }

  .sv-cs-arrow {
    display: inline-block;
  }

  @media (max-width: 900px) {
    .hp-services { grid-template-columns: 1fr; }
    .services-sidebar {
      position: static;
      min-height: unset;
      padding: 24px var(--px);
      border-right: none;
      border-bottom: 0.5px solid #E5E4E0;
    }
    .services-nav {
      flex-direction: row;
      gap: 20px;
      flex-wrap: wrap;
    }
  }

  @media (max-width: 768px) {
    .sv-project { grid-template-columns: 1fr; }
  }

  /* ── Who we work with ────────────────────────────────────────── */
  .hp-clients {
    padding: var(--py) 0;
    overflow: hidden;
  }

  .clients-copy {
    padding: 0 var(--px);
    margin-bottom: clamp(48px, 6vw, 80px);
  }

  .clients-label {
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #888888;
    margin-bottom: clamp(28px, 3.5vw, 44px);
  }

  .clients-body {
    font-size: clamp(20px, 2.2vw, 26px);
    font-weight: 300;
    line-height: 1.65;
    color: #111111;
    max-width: 76ch;
  }

  .marquee {
    border-top: 0.5px solid #E5E4E0;
    border-bottom: 0.5px solid #E5E4E0;
    padding: clamp(24px, 3vw, 40px) 0;
    overflow: hidden;
    width: 100%;
  }

  .marquee-track {
    display: flex;
    align-items: center;
    gap: clamp(56px, 7vw, 112px);
    width: max-content;
    animation: marquee 48s linear infinite;
  }

  @keyframes marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  .marquee-logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }
  .marquee-logo :global(svg) {
    height: 32px;
    width: auto;
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
      flex-wrap: wrap;
      width: auto;
      padding: 0 var(--px);
      gap: 14px 40px;
    }
    .marquee-track > span:nth-child(n+10) { display: none; }
  }

  @media (max-width: 768px) {
    .hp-clients { padding-top: 40px; }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
    list-style: none;
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Connect Lenis to ScrollTrigger
  const lenis = (window as any).__lenis;
  if (lenis) lenis.on('scroll', ScrollTrigger.update);

  // Hero: staggered line reveal on page load
  const heroLines = document.querySelectorAll<HTMLElement>('.hp-line-inner');
  const heroSub   = document.querySelector<HTMLElement>('.hp-sub');

  if (!prefersReduced && heroLines.length && heroSub) {
    gsap.set(heroLines, { yPercent: 100, clipPath: 'inset(100% 0 0 0)' });
    gsap.set(heroSub,   { y: 20, opacity: 0 });

    gsap.timeline({ defaults: { ease: 'power3.out' } })
      .to(heroLines, {
        yPercent: 0,
        clipPath: 'inset(0% 0% 0% 0%)',
        duration: 0.85,
        stagger: 0.12,
      })
      .to(heroSub, {
        y: 0,
        opacity: 1,
        duration: 0.6,
      }, '-=0.35');
  }

  // Quote: word-by-word scroll reveal
  const quoteSection = document.querySelector<HTMLElement>('.hp-quote');
  const quoteWords   = document.querySelectorAll<HTMLElement>('.quote-word');

  if (!prefersReduced && quoteSection && quoteWords.length) {
    gsap.to(quoteWords, {
      color: '#111111',
      stagger: { each: 0.15 },
      ease: 'none',
      scrollTrigger: {
        trigger: quoteSection,
        start: 'top top',
        end: `+=${quoteWords.length * 70}`,
        pin: true,
        scrub: 0.8,
        anticipatePin: 1,
      },
    });
  }

  // Services: highlight active sidebar link as panels scroll into view
  const servicePanels = document.querySelectorAll<HTMLElement>('.service-panel');
  const serviceLinks  = document.querySelectorAll<HTMLElement>('.services-link');

  if (servicePanels.length && serviceLinks.length) {
    const panelObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const id = entry.target.id;
            serviceLinks.forEach(link => {
              link.classList.toggle('is-active', (link as HTMLAnchorElement).dataset.target === id);
            });
          }
        });
      },
      { rootMargin: '-10% 0px -70% 0px', threshold: 0 }
    );
    servicePanels.forEach(p => panelObserver.observe(p));
  }

  // "View case study" arrow nudge
  document.querySelectorAll<HTMLElement>('.sv-cs-link').forEach(link => {
    const arrow = link.querySelector<HTMLElement>('.sv-cs-arrow');
    if (!arrow) return;
    link.addEventListener('mouseenter', () =>
      gsap.to(arrow, { x: 4, duration: 0.2, ease: 'power1.out' }));
    link.addEventListener('mouseleave', () =>
      gsap.to(arrow, { x: 0, duration: 0.2, ease: 'power1.out' }));
  });
</script>

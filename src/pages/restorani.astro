<script>
  // Personalizacija ?r=
  const params = new URLSearchParams(window.location.search);
  const rawName = (params.get('r') ?? '').trim().slice(0, 60);
  if (rawName) {
    const line = document.getElementById('preparedFor');
    const nameEl = document.getElementById('preparedName');
    if (line && nameEl) { nameEl.textContent = rawName; line.hidden = false; }
    const wa = document.getElementById('waBtn') as HTMLAnchorElement | null;
    if (wa) {
      const text = `${wa.dataset.text} Restoran: ${rawName}`;
      wa.href = `https://wa.me/${wa.dataset.number}?text=${encodeURIComponent(text)}`;
      wa.setAttribute('data-umami-event-restoran', rawName);
    }
    document.getElementById('telBtn')?.setAttribute('data-umami-event-restoran', rawName);
    // Umami: zabilježi otvaranje personalizovanog linka
    let tries = 0;
    const track = () => {
      const umami = (window as any).umami;
      if (umami && typeof umami.track === 'function') { umami.track('restorani-otvoren', { restoran: rawName }); return; }
      if (++tries < 10) setTimeout(track, 300);
    };
    if (document.readyState === 'complete') track(); else window.addEventListener('load', track);
  }

  // Header: Contact skrola na kontakt sekciju
  document.querySelectorAll<HTMLAnchorElement>('.nav-link[href="/contact"]').forEach((link) => {
    link.href = '#kontakt';
    const label = link.querySelector('.link-text');
    if (label) label.textContent = 'Kontakt';
    link.addEventListener('click', (e) => {
      const target = document.getElementById('kontakt');
      if (!target) return;
      e.preventDefault();
      setTimeout(() => {
        const lenis = (window as any).__lenis;
        if (lenis) lenis.scrollTo(target); else target.scrollIntoView({ behavior: 'smooth' });
      }, 350);
    });
  });

  // Video
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const videos = Array.from(document.querySelectorAll<HTMLVideoElement>('.r-video'));
  const soundButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.r-sound'));
  const userStarted = new WeakSet<HTMLVideoElement>();

  const setSoundLabel = (btn: HTMLButtonElement, muted: boolean) => {
    btn.textContent = muted ? 'Uključi zvuk' : 'Isključi zvuk';
    btn.setAttribute('aria-pressed', muted ? 'false' : 'true');
  };

  soundButtons.forEach((btn) => {
    const video = btn.parentElement?.querySelector('video') as HTMLVideoElement | null;
    if (!video) return;
    btn.addEventListener('click', () => {
      const unmute = video.muted;
      if (unmute) {
        soundButtons.forEach((other) => {
          const v = other.parentElement?.querySelector('video') as HTMLVideoElement | null;
          if (v && v !== video) { v.muted = true; setSoundLabel(other, true); }
        });
        if (video.paused) { video.play().catch(() => {}); userStarted.add(video); }
      }
      video.muted = !unmute;
      setSoundLabel(btn, video.muted);
    });
  });

  videos.forEach((video) => {
    const playBtn = video.parentElement?.querySelector('.r-play') as HTMLButtonElement | null;
    if (reduceMotion && playBtn) {
      playBtn.hidden = false;
      playBtn.addEventListener('click', () => {
        userStarted.add(video);
        video.play().catch(() => {});
        playBtn.hidden = true;
      });
    }
  });

  const io = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      const video = entry.target as HTMLVideoElement;
      if (entry.isIntersecting) {
        if (!reduceMotion || userStarted.has(video)) video.play().catch(() => {});
      } else if (!video.paused) {
        video.pause();
      }
    });
  }, { threshold: 0.25 });
  videos.forEach((v) => io.observe(v));
</script>

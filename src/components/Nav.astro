---
import wordmarkSvgRaw from '../assets/brand/sett-wordmark.svg?raw';
import { noWidow } from '../utils/noWidow';
---

<header class="site-header" id="siteHeader">
  <a href="/" class="site-logo" aria-label="Sett Agency — Home">
    <Fragment set:html={wordmarkSvgRaw.replace(/<\?xml[^>]*\?>\s*/, '')} />
  </a>
  <button class="hamburger" id="hamburger" aria-label="Open navigation" aria-expanded="false">
    <span class="ham-line ham-1"></span>
    <span class="ham-line ham-2"></span>
    <span class="ham-line ham-3"></span>
  </button>
</header>

<div class="nav-overlay" id="navOverlay" aria-hidden="true">
  <nav class="overlay-nav" aria-label="Main navigation">
    <a href="/work" class="nav-link">
      <span class="link-text">Work</span>
      <svg class="link-arrow" viewBox="0 0 46 20" width="46" height="20" fill="none" stroke="#F7F6F2" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
        <line class="arrow-line" x1="0" y1="10" x2="40" y2="10" stroke-dasharray="40" stroke-dashoffset="40" />
        <polyline class="arrow-head" points="34,5 40,10 34,15" stroke-dasharray="16" stroke-dashoffset="16" />
      </svg>
    </a>
    <a href="/about" class="nav-link">
      <span class="link-text">About</span>
      <svg class="link-arrow" viewBox="0 0 46 20" width="46" height="20" fill="none" stroke="#F7F6F2" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
        <line class="arrow-line" x1="0" y1="10" x2="40" y2="10" stroke-dasharray="40" stroke-dashoffset="40" />
        <polyline class="arrow-head" points="34,5 40,10 34,15" stroke-dasharray="16" stroke-dashoffset="16" />
      </svg>
    </a>
    <a href="/services" class="nav-link">
      <span class="link-text">Services</span>
      <svg class="link-arrow" viewBox="0 0 46 20" width="46" height="20" fill="none" stroke="#F7F6F2" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
        <line class="arrow-line" x1="0" y1="10" x2="40" y2="10" stroke-dasharray="40" stroke-dashoffset="40" />
        <polyline class="arrow-head" points="34,5 40,10 34,15" stroke-dasharray="16" stroke-dashoffset="16" />
      </svg>
    </a>
    <a href="/contact" class="nav-link">
      <span class="link-text">Contact</span>
      <svg class="link-arrow" viewBox="0 0 46 20" width="46" height="20" fill="none" stroke="#F7F6F2" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
        <line class="arrow-line" x1="0" y1="10" x2="40" y2="10" stroke-dasharray="40" stroke-dashoffset="40" />
        <polyline class="arrow-head" points="34,5 40,10 34,15" stroke-dasharray="16" stroke-dashoffset="16" />
      </svg>
    </a>
  </nav>

  <footer class="overlay-footer" id="overlayFooter">
    <p class="footer-tagline">{noWidow("Setting up brands that value their business.")}</p>
    <div class="footer-contact">
      <a href="tel:+38763031859" class="contact-phone">+387 63 031 859</a>
      <a href="mailto:hello@settagency.com" class="contact-email">hello@settagency.com</a>
      <ul class="social-links">
        <li><a href="https://www.instagram.com/sett.agency/" target="_blank" rel="noopener noreferrer">Instagram</a></li>
        <li><a href="https://www.linkedin.com/company/sett-agency/?viewAsMember=true" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
      </ul>
    </div>
  </footer>
</div>

<style>
  :root {
    --nav-px: clamp(24px, 6vw, 80px);
    --header-h: 81px; /* 26px top + 29px logo + 26px bottom */
  }

  @media (min-width: 769px) {
    :root {
      --header-h: 85px; /* 28px top + 29px logo + 28px bottom */
    }
  }

  /* Header */
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 26px var(--nav-px);
    transition: background 0.3s ease, border-color 0.3s ease;
  }

  @media (min-width: 769px) {
    .site-header {
      padding: 28px var(--nav-px);
    }
  }
  .site-header.scrolled {
    background: #F7F6F2;
    border-bottom: 0.5px solid #E5E4E0;
  }
  .site-header.nav-open {
    background: transparent;
    border-bottom-color: transparent;
  }

  /* Logo */
  .site-logo {
    display: flex;
    align-items: center;
    color: #111111;
    transition: color 0.3s ease;
  }
  :global(.site-logo svg) {
    height: 29px;
    width: auto;
    display: block;
    fill: currentColor;
  }
  :global(.site-logo svg path) {
    fill: currentColor;
  }
  .site-header.nav-open .site-logo {
    color: #F7F6F2;
  }

  /* Hamburger */
  .hamburger {
    position: relative;
    width: 43px;
    height: 26px;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    flex-shrink: 0;
  }
  .ham-line {
    position: absolute;
    left: 0;
    width: 43px;
    height: 2px;
    background: #111111;
    transition: transform 0.35s ease, opacity 0.25s ease, background 0.3s ease;
  }
  .ham-1 { top: 0; }
  .ham-2 { top: 12px; }
  .ham-3 { top: 24px; }

  .site-header.nav-open .ham-line { background: #F7F6F2; }
  .site-header.nav-open .ham-1    { transform: translateY(12px) rotate(45deg); }
  .site-header.nav-open .ham-2    { opacity: 0; transform: scaleX(0); }
  .site-header.nav-open .ham-3    { transform: translateY(-12px) rotate(-45deg); }

  /* Overlay */
  .nav-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: #111111;
    display: flex;
    flex-direction: column;
    padding-top: var(--header-h);
    transform: translateY(-100%);
    transition: transform 0.7s cubic-bezier(0.7, 0, 0.2, 1);
    overflow: hidden;
  }
  .nav-overlay.is-open { transform: translateY(0); }

  /* Nav links */
  .overlay-nav {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0 var(--nav-px);
  }
  .nav-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: clamp(42px, 7vw, 84px);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: #F7F6F2;
    padding: 16px 0;
    border-bottom: 0.5px solid #222222;
    will-change: transform, opacity;
    transition: color 0.25s ease;
  }
  .nav-link:hover       { color: #FFFFFF; }
  .nav-link:first-child { border-top: 0.5px solid #222222; }
  .nav-link:last-child  { border-bottom: none; }

  .link-arrow {
    flex-shrink: 0;
    overflow: visible;
    display: block;
  }

  /* Overlay footer */
  .overlay-footer {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 40px;
    padding: 24px var(--nav-px) 40px;
    border-top: 0.5px solid #333333;
  }
  .footer-tagline {
    font-size: 18px;
    font-weight: 300;
    line-height: 1.5;
    color: #888888;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .footer-contact {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
  }
  .contact-phone,
  .contact-email {
    font-size: 16px;
    font-weight: 400;
    color: #888888;
    line-height: 1.5;
  }
  .social-links {
    list-style: none;
    display: flex;
    flex-direction: row;
    gap: 20px;
    margin-top: 12px;
  }
  .social-links a {
    font-size: 13px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #666666;
  }

  /* Mobile */
  @media (max-width: 768px) {
    .link-arrow { display: none; }
    .nav-link { font-size: clamp(63px, 12vw, 70px); }
    .overlay-footer {
      flex-direction: column;
      align-items: flex-start;
      gap: 40px;
    }
    .footer-tagline {
      white-space: normal;
      font-size: 16px;
    }
    .footer-contact { align-items: flex-start; }
    .social-links { flex-wrap: wrap; }
  }
</style>

<script>
  import gsap from 'gsap';

  const header    = document.getElementById('siteHeader')!;
  const hamburger = document.getElementById('hamburger')!;
  const overlay   = document.getElementById('navOverlay')!;
  const navLinks  = overlay.querySelectorAll<HTMLElement>('.nav-link');
  const footer    = document.getElementById('overlayFooter')!;

  let isOpen      = false;
  let headerShown = true;
  let lastScrollY = window.scrollY;

  gsap.set(navLinks, { opacity: 0, y: 20 });
  gsap.set(footer, { opacity: 0 });

  function openNav() {
    isOpen = true;
    gsap.to(header, { y: 0, duration: 0.4, ease: 'power2.out', overwrite: true });
    headerShown = true;
    overlay.classList.add('is-open');
    overlay.removeAttribute('aria-hidden');
    header.classList.add('nav-open');
    hamburger.setAttribute('aria-expanded', 'true');
    document.body.classList.add('nav-open');
    (window as any).__lenis?.stop();

    gsap.to(navLinks, {
      opacity: 1, y: 0,
      duration: 0.5, stagger: 0.07, delay: 0.25,
      ease: 'power2.out', overwrite: true,
    });
    gsap.to(footer, {
      opacity: 1,
      duration: 0.4, delay: 0.5,
      ease: 'power2.out', overwrite: true,
    });
  }

  function closeNav() {
    isOpen = false;
    lastScrollY = window.scrollY;
    gsap.set(navLinks, { opacity: 0, y: 20 });
    gsap.set(footer, { opacity: 0 });
    overlay.classList.remove('is-open');
    overlay.setAttribute('aria-hidden', 'true');
    header.classList.remove('nav-open');
    hamburger.setAttribute('aria-expanded', 'false');
    document.body.classList.remove('nav-open');
    (window as any).__lenis?.start();
  }

  hamburger.addEventListener('click', () => (isOpen ? closeNav() : openNav()));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && isOpen) closeNav(); });
  navLinks.forEach((link) => link.addEventListener('click', closeNav));

  // Scroll-direction hide/show
  window.addEventListener('scroll', () => {
    if (isOpen) return;
    const y = window.scrollY;
    if (y <= 0) {
      if (!headerShown) {
        gsap.to(header, { y: 0, duration: 0.4, ease: 'power2.out', overwrite: true });
        headerShown = true;
      }
    } else if (y > lastScrollY + 4 && headerShown) {
      gsap.to(header, { y: '-100%', duration: 0.4, ease: 'power2.out', overwrite: true });
      headerShown = false;
    } else if (y < lastScrollY - 4 && !headerShown) {
      gsap.to(header, { y: 0, duration: 0.4, ease: 'power2.out', overwrite: true });
      headerShown = true;
    }
    lastScrollY = y;
  }, { passive: true });

  // Stroked arrow: GSAP timeline per link
  navLinks.forEach((link) => {
    const arrowLine = link.querySelector<SVGLineElement>('.arrow-line')!;
    const arrowHead = link.querySelector<SVGPolylineElement>('.arrow-head')!;

    const tl = gsap.timeline({ paused: true });
    tl
      .to(arrowLine, { strokeDashoffset: 0, duration: 0.3, ease: 'power2.inOut' }, 0)
      .to(arrowHead, { strokeDashoffset: 0, duration: 0.2, ease: 'power2.out'  }, 0.25);

    link.addEventListener('mouseenter', () => tl.play());
    link.addEventListener('mouseleave', () => tl.reverse());
  });
</script>

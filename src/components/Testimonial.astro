---
import { noWidow } from '../utils/noWidow';

interface TestimonialItem {
  quote: string;
  name: string;
  role: string;
}

interface Props {
  testimonials: TestimonialItem[];
  showArrows?: boolean;
}

const { testimonials, showArrows = false } = Astro.props;
const first = testimonials[0];
---

<section
  class:list={['ts-section', { 'ts-section--carousel': showArrows }]}
  data-testimonials={showArrows ? JSON.stringify(testimonials) : undefined}
>
  <div class="ts-header">
    <div class="ts-label-row">
      <span class="ts-label">Client Stories</span>
      <span class="ts-rule" aria-hidden="true"></span>
    </div>
    <h2 class="ts-heading">In their words.</h2>
  </div>

  <div class="ts-card">
    <span class="ts-quote-mark" aria-hidden="true">&ldquo;</span>
    <p class="ts-quote" data-field="quote">{noWidow(first.quote)}</p>
    <div class="ts-divider" aria-hidden="true"></div>
    <div class="ts-attr">
      <span class="ts-name" data-field="name">{noWidow(first.name)}</span>
      <span class="ts-role" data-field="role">{noWidow(first.role)}</span>
    </div>
    {showArrows && (
      <div class="ts-controls">
        <button class="ts-arrow ts-arrow--prev" aria-label="Previous testimonial">←</button>
        <button class="ts-arrow ts-arrow--next" aria-label="Next testimonial">→</button>
      </div>
    )}
  </div>
</section>

<style>
  .ts-section {
    padding: var(--py, clamp(60px, 8vw, 96px)) var(--px, clamp(24px, 6vw, 80px));
    border-bottom: 0.5px solid #E5E4E0;
  }

  /* ── Header ──────────────────────────────────── */
  .ts-header {
    margin-bottom: clamp(28px, 4vw, 40px);
  }

  .ts-label-row {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 16px;
  }

  .ts-label {
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #888888;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .ts-rule {
    display: block;
    width: clamp(40px, 6vw, 80px);
    height: 0.5px;
    background: #E5E4E0;
    flex-shrink: 0;
  }

  .ts-heading {
    font-size: clamp(1.75rem, 3.5vw, 3rem);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: #111111;
  }

  /* ── Card ────────────────────────────────────── */
  .ts-card {
    background: #F0EFEB;
    padding: clamp(32px, 4vw, 56px);
  }

  .ts-quote-mark {
    display: block;
    font-size: clamp(48px, 6vw, 64px);
    font-weight: 700;
    line-height: 0.85;
    color: #111111;
    margin-bottom: 20px;
    user-select: none;
  }

  .ts-quote {
    font-size: clamp(18px, 1.5vw, 21px);
    font-weight: 300;
    line-height: 1.6;
    color: #111111;
    max-width: 72ch;
    overflow-wrap: break-word;
    margin-bottom: 28px;
  }

  .ts-divider {
    width: clamp(80px, 38%, 260px);
    height: 0.5px;
    background: #E5E4E0;
    margin-bottom: 24px;
  }

  .ts-attr {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .ts-name {
    font-size: 14px;
    font-weight: 600;
    color: #111111;
    line-height: 1.4;
  }

  .ts-role {
    font-size: 13px;
    font-weight: 300;
    color: #888888;
    line-height: 1.4;
  }

  /* ── Carousel controls ───────────────────────── */
  .ts-controls {
    display: flex;
    align-items: center;
    gap: 0;
    justify-content: flex-end;
    margin-top: 32px;
  }

  .ts-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 18px;
    font-family: inherit;
    font-weight: 400;
    color: #111111;
    padding: 0 10px;
    transition: color 0.15s ease;
    line-height: 1;
  }

  .ts-arrow:hover { color: #555555; }

  @media (prefers-reduced-motion: reduce) {
    .ts-arrow { transition: none; }
  }

  /* ── Mobile ──────────────────────────────────── */
  @media (max-width: 768px) {
    .ts-quote {
      font-size: 18px;
    }
    .ts-card {
      padding: 32px;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.ts-section--carousel').forEach(section => {
    const raw = section.dataset.testimonials;
    if (!raw) return;

    const items: Array<{ quote: string; name: string; role: string }> = JSON.parse(raw);
    if (items.length < 2) return;

    let current = 0;
    let busy = false;

    const card    = section.querySelector<HTMLElement>('.ts-card')!;
    const quoteEl = section.querySelector<HTMLElement>('[data-field="quote"]')!;
    const nameEl  = section.querySelector<HTMLElement>('[data-field="name"]')!;
    const roleEl  = section.querySelector<HTMLElement>('[data-field="role"]')!;
    const prevBtn = section.querySelector<HTMLButtonElement>('.ts-arrow--prev')!;
    const nextBtn = section.querySelector<HTMLButtonElement>('.ts-arrow--next')!;

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function updateContent(index: number) {
      current = ((index % items.length) + items.length) % items.length;
      const t = items[current];
      quoteEl.textContent = t.quote;
      nameEl.textContent  = t.name;
      roleEl.textContent  = t.role;
    }

    function goTo(index: number) {
      if (busy) return;

      if (prefersReduced) {
        updateContent(index);
        return;
      }

      busy = true;
      import('gsap').then(({ default: gsap }) => {
        gsap.to(card, {
          opacity: 0,
          y: -6,
          duration: 0.18,
          ease: 'power2.in',
          onComplete() {
            updateContent(index);
            gsap.fromTo(
              card,
              { opacity: 0, y: 8 },
              {
                opacity: 1,
                y: 0,
                duration: 0.25,
                ease: 'power2.out',
                onComplete: () => { busy = false; },
              }
            );
          },
        });
      }).catch(() => {
        updateContent(index);
        busy = false;
      });
    }

    prevBtn.addEventListener('click', () => goTo(current - 1));
    nextBtn.addEventListener('click', () => goTo(current + 1));
  });
</script>
